# Desarrollo local: Vite proxyea /api hacia Django (vite.config.js).
# Producción: el frontend usa rutas relativas /api/ en el mismo dominio;
# no hace falta cambiar nada antes de npm run build si Apache hace ProxyPass /api/.

# Opcional — solo si en el futuro usas URL absoluta del API:
# VITE_API_URL=http://127.0.0.1:8000
