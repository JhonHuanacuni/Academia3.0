SECRET_KEY=django-insecure-change-me
DEBUG=True

# mysql (local Linode/producción) | mssql (SQL Server legacy) | sqlite
DB_ENGINE=mysql
DB_NAME=AcademiaDB
DB_USER=root
DB_PASSWORD=tu_contraseña
